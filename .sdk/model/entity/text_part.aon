      type: "`$STRING`"
    }
    {
      name: "wayName"
      req: false
      short: "Name of the street or road"
      type: "`$STRING`"
    }
    {
      name: "wayRef"
      req: false
      short: "Reference identifier for the way (e.g., road number)"
      type: "`$STRING`"
    }
  ]

  name: "text_part"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
