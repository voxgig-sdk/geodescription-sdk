# Entity: reverse_geocoding

main: kit: entity: reverse_geocoding: {

  alias: field: {}

  name: "reverse_geocoding"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /text"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "key"
                or: "key"
                r: false
                t: "`$STRING`"
              }
              {
                ex: 51.3034
                k: "query"
                n: "lat"
                or: "lat"
                r: true
                t: "`$NUMBER`"
              }
              {
                ex: -0.3063
                k: "query"
                n: "lon"
                or: "lon"
                r: true
                t: "`$NUMBER`"
              }
            ]
          }
          m: "GET"
          o: "/text"
          q: {
            exist: [
              "key"
              "lat"
              "lon"
            ]
          }
          s: [
            {
              lit: "text"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          co: {
            id: "GET /text/lat={latitude}/lon={longitude}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: 51.3034
                k: "param"
                n: "latitude"
                or: "latitude"
                r: true
                t: "`$NUMBER`"
              }
              {
                ex: -0.3063
                k: "param"
                n: "longitude"
                or: "longitude"
                r: true
                t: "`$NUMBER`"
              }
            ]
            query: [
              {
                k: "query"
                n: "key"
                or: "key"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/text/lat={latitude}/lon={longitude}"
          q: {
            exist: [
              "key"
              "latitude"
              "longitude"
            ]
          }
          s: [
            {
              lit: "text"
            }
            {
              lit: "lat={latitude}"
            }
            {
              lit: "lon={longitude}"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  fields: {
  }



}
